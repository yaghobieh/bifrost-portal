{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/cms",
      "destination": "/index.html"
    },
    {
      "source": "/cms/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/api/cms/media/config",
      "destination": "/api/health?rest=media-config"
    },
    {
      "source": "/api/public/plugins",
      "destination": "/api/health?rest=plugins"
    },
    {
      "source": "/api/v1/version",
      "destination": "/api/health?rest=version"
    },
    {
      "source": "/api/version",
      "destination": "/api/health?rest=version"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/cms/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
