{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/cms/media/config",
      "destination": "/api/health?rest=media-config"
    },
    {
      "source": "/api/public/plugins",
      "destination": "/api/health?rest=plugins"
    },
    {
      "source": "/api/public/nav",
      "destination": "/api/c/pages?rest=nav"
    },
    {
      "source": "/api/v1/version",
      "destination": "/api/health?rest=version"
    },
    {
      "source": "/api/version",
      "destination": "/api/health?rest=version"
    },
    {
      "source": "/api/cms/settings/:key",
      "destination": "/api/c/dashboard?rest=settings&key=:key"
    },
    {
      "source": "/api/v1/page",
      "destination": "/api/c/pages?rest=page"
    },
    {
      "source": "/api/blog/posts",
      "destination": "/api/c/pages?rest=blog"
    },
    {
      "source": "/api/blog/posts/:slug",
      "destination": "/api/c/pages?rest=blog&slug=:slug"
    },
    {
      "source": "/api/cms/create-user",
      "destination": "/api/c/users?rest=create"
    },
    {
      "source": "/api/cms/update-user-role/:id",
      "destination": "/api/c/users?rest=role&id=:id"
    },
    {
      "source": "/api/cms/create-role",
      "destination": "/api/c/roles?rest=create"
    },
    {
      "source": "/api/cms/update-role/:id",
      "destination": "/api/c/roles?rest=update&id=:id"
    },
    {
      "source": "/api/cms/delete-role/:id",
      "destination": "/api/c/roles?rest=delete&id=:id"
    },
    {
      "source": "/api/cms/:path*",
      "destination": "/api/c/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/cms/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
